<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- Ported RB botbase: keep nullable off to avoid annotation noise. -->
    <Nullable>disable</Nullable>
    <!-- No ImplicitUsings: the runtime CodeCompiler compiles these files without them,
         so every file must carry explicit usings; building the same way here catches misses. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- SettingsForm is WinForms; ModifierKeys comes from WPF's System.Windows.Input. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RootNamespace>RaidCombat</RootNamespace>
    <AssemblyName>RaidCombat</AssemblyName>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <!-- Deployed as SOURCE by BuddyCron's copy target; this DLL is never shipped, so skip the
         project when the solution is published. Building it (the point of this project) is
         unaffected. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- BotBase, TreeHooks/Treesharp, Navigator, HotkeyManager and JsonSettings all live in
       BuddyCron and its transitive Reborn.* refs. BuddyCronRefs.props supplies them as project
       references in the repo and through the compile-only reference package when this .csproj is
       opened from the copy that ships inside an install. -->
  <PropertyGroup>
    <BuddyCronRefsProps>$([MSBuild]::GetPathOfFileAbove('BuddyCronRefs.props', '$(MSBuildThisFileDirectory)'))</BuddyCronRefsProps>
  </PropertyGroup>
  <Import Project="$(BuddyCronRefsProps)" Condition="'$(BuddyCronRefsProps)' != ''" />

</Project>
